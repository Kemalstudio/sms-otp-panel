<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- The device token must never leave the handset it was issued to. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="gateway_device.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="gateway_device.xml" />
    </device-transfer>
</data-extraction-rules>
